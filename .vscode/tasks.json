{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++ build active file",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "killProcess",
            "type": "shell",
            "command": "taskkill",
            "args": [
                "/IM",
                "${fileBasenameNoExtension}.exe",
                "/F"
            ],
            "problemMatcher": []
        }
    ]
}
